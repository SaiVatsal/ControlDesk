<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <Authors>ControlDesk Engineering</Authors>
    <Company>ControlDesk</Company>
    <Product>ControlDesk Remote Desktop</Product>
    <Copyright>Copyright © 2026 ControlDesk</Copyright>
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904</NoWarn>
  </PropertyGroup>
</Project>
