<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base Colors -->
    <Color x:Key="ColorPrimary">#0066CC</Color>
    <Color x:Key="ColorPrimaryHover">#0052A3</Color>
    <Color x:Key="ColorPrimaryPressed">#004080</Color>
    <Color x:Key="ColorPrimaryDisabled">#99C2E8</Color>

    <Color x:Key="ColorSecondary">#4A4A4A</Color>
    <Color x:Key="ColorSecondaryHover">#3D3D3D</Color>
    <Color x:Key="ColorSecondaryPressed">#2E2E2E</Color>
    <Color x:Key="ColorSecondaryDisabled">#CCCCCC</Color>

    <Color x:Key="ColorBackground">#FFFFFF</Color>
    <Color x:Key="ColorSurface">#F5F5F5</Color>
    <Color x:Key="ColorSurfaceHover">#EBEBEB</Color>
    <Color x:Key="ColorBorder">#D0D0D0</Color>
    <Color x:Key="ColorBorderFocus">#0066CC</Color>

    <Color x:Key="ColorTextPrimary">#1A1A1A</Color>
    <Color x:Key="ColorTextSecondary">#4A4A4A</Color>
    <Color x:Key="ColorTextDisabled">#999999</Color>
    <Color x:Key="ColorTextOnPrimary">#FFFFFF</Color>
    <Color x:Key="ColorTextOnSecondary">#FFFFFF</Color>

    <Color x:Key="ColorSuccess">#2E7D32</Color>
    <Color x:Key="ColorSuccessBackground">#E8F5E9</Color>
    <Color x:Key="ColorWarning">#F57F17</Color>
    <Color x:Key="ColorWarningBackground">#FFF8E1</Color>
    <Color x:Key="ColorError">#C62828</Color>
    <Color x:Key="ColorErrorBackground">#FDE0E0</Color>
    <Color x:Key="ColorInfo">#0277BD</Color>
    <Color x:Key="ColorInfoBackground">#E1F5FE</Color>

    <!-- Solid Color Brushes -->
    <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}"/>
    <SolidColorBrush x:Key="BrushPrimaryHover" Color="{StaticResource ColorPrimaryHover}"/>
    <SolidColorBrush x:Key="BrushPrimaryPressed" Color="{StaticResource ColorPrimaryPressed}"/>
    <SolidColorBrush x:Key="BrushPrimaryDisabled" Color="{StaticResource ColorPrimaryDisabled}"/>

    <SolidColorBrush x:Key="BrushSecondary" Color="{StaticResource ColorSecondary}"/>
    <SolidColorBrush x:Key="BrushSecondaryHover" Color="{StaticResource ColorSecondaryHover}"/>
    <SolidColorBrush x:Key="BrushSecondaryPressed" Color="{StaticResource ColorSecondaryPressed}"/>
    <SolidColorBrush x:Key="BrushSecondaryDisabled" Color="{StaticResource ColorSecondaryDisabled}"/>

    <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}"/>
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}"/>
    <SolidColorBrush x:Key="BrushSurfaceHover" Color="{StaticResource ColorSurfaceHover}"/>
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}"/>
    <SolidColorBrush x:Key="BrushBorderFocus" Color="{StaticResource ColorBorderFocus}"/>

    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="BrushTextDisabled" Color="{StaticResource ColorTextDisabled}"/>
    <SolidColorBrush x:Key="BrushTextOnPrimary" Color="{StaticResource ColorTextOnPrimary}"/>
    <SolidColorBrush x:Key="BrushTextOnSecondary" Color="{StaticResource ColorTextOnSecondary}"/>

    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}"/>
    <SolidColorBrush x:Key="BrushSuccessBackground" Color="{StaticResource ColorSuccessBackground}"/>
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}"/>
    <SolidColorBrush x:Key="BrushWarningBackground" Color="{StaticResource ColorWarningBackground}"/>
    <SolidColorBrush x:Key="BrushError" Color="{StaticResource ColorError}"/>
    <SolidColorBrush x:Key="BrushErrorBackground" Color="{StaticResource ColorErrorBackground}"/>
    <SolidColorBrush x:Key="BrushInfo" Color="{StaticResource ColorInfo}"/>
    <SolidColorBrush x:Key="BrushInfoBackground" Color="{StaticResource ColorInfoBackground}"/>

    <!-- Focus Visual -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="2" Stroke="{StaticResource BrushBorderFocus}" StrokeThickness="1" StrokeDashArray="1 2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>