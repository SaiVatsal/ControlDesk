<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Clean, High-Contrast Professional Dark Theme with Neutral Accents (Zero Animation) -->

    <!-- Backgrounds -->
    <Color x:Key="Color.Background.Primary">#121214</Color>
    <Color x:Key="Color.Background.Secondary">#18181B</Color>
    <Color x:Key="Color.Background.Tertiary">#27272A</Color>
    <Color x:Key="Color.Background.Hover">#323238</Color>
    <Color x:Key="Color.Background.Active">#3F3F46</Color>
    <Color x:Key="Color.Background.Input">#1E1E22</Color>
    <Color x:Key="Color.Background.Overlay">#80000000</Color>

    <!-- Borders -->
    <Color x:Key="Color.Border.Subtle">#27272A</Color>
    <Color x:Key="Color.Border.Default">#3F3F46</Color>
    <Color x:Key="Color.Border.Focus">#3B82F6</Color>

    <!-- Text -->
    <Color x:Key="Color.Text.Primary">#F4F4F5</Color>
    <Color x:Key="Color.Text.Secondary">#A1A1AA</Color>
    <Color x:Key="Color.Text.Muted">#71717A</Color>
    <Color x:Key="Color.Text.Inverse">#09090B</Color>

    <!-- Accent / Status -->
    <Color x:Key="Color.Accent.Primary">#3B82F6</Color>
    <Color x:Key="Color.Accent.Hover">#2563EB</Color>
    <Color x:Key="Color.Accent.Active">#1D4ED8</Color>

    <Color x:Key="Color.Status.Online">#10B981</Color>
    <Color x:Key="Color.Status.Connecting">#F59E0B</Color>
    <Color x:Key="Color.Status.Offline">#6B7280</Color>
    <Color x:Key="Color.Status.Error">#EF4444</Color>
    <Color x:Key="Color.Status.Warning">#F59E0B</Color>
    <Color x:Key="Color.Status.Success">#10B981</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="Brush.Background.Primary" Color="{StaticResource Color.Background.Primary}" />
    <SolidColorBrush x:Key="Brush.Background.Secondary" Color="{StaticResource Color.Background.Secondary}" />
    <SolidColorBrush x:Key="Brush.Background.Tertiary" Color="{StaticResource Color.Background.Tertiary}" />
    <SolidColorBrush x:Key="Brush.Background.Hover" Color="{StaticResource Color.Background.Hover}" />
    <SolidColorBrush x:Key="Brush.Background.Active" Color="{StaticResource Color.Background.Active}" />
    <SolidColorBrush x:Key="Brush.Background.Input" Color="{StaticResource Color.Background.Input}" />
    <SolidColorBrush x:Key="Brush.Background.Overlay" Color="{StaticResource Color.Background.Overlay}" />

    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="{StaticResource Color.Border.Subtle}" />
    <SolidColorBrush x:Key="Brush.Border.Default" Color="{StaticResource Color.Border.Default}" />
    <SolidColorBrush x:Key="Brush.Border.Focus" Color="{StaticResource Color.Border.Focus}" />

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="{StaticResource Color.Text.Muted}" />
    <SolidColorBrush x:Key="Brush.Text.Inverse" Color="{StaticResource Color.Text.Inverse}" />

    <SolidColorBrush x:Key="Brush.Accent.Primary" Color="{StaticResource Color.Accent.Primary}" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource Color.Accent.Hover}" />
    <SolidColorBrush x:Key="Brush.Accent.Active" Color="{StaticResource Color.Accent.Active}" />

    <SolidColorBrush x:Key="Brush.Status.Online" Color="{StaticResource Color.Status.Online}" />
    <SolidColorBrush x:Key="Brush.Status.Connecting" Color="{StaticResource Color.Status.Connecting}" />
    <SolidColorBrush x:Key="Brush.Status.Offline" Color="{StaticResource Color.Status.Offline}" />
    <SolidColorBrush x:Key="Brush.Status.Error" Color="{StaticResource Color.Status.Error}" />
    <SolidColorBrush x:Key="Brush.Status.Warning" Color="{StaticResource Color.Status.Warning}" />
    <SolidColorBrush x:Key="Brush.Status.Success" Color="{StaticResource Color.Status.Success}" />

    <!-- Status Light Variants (for error banners, etc.) -->
    <Color x:Key="Color.Status.Error.Light">#2D1517</Color>
    <SolidColorBrush x:Key="Brush.Status.Error.Light" Color="{StaticResource Color.Status.Error.Light}" />

    <Color x:Key="Color.Status.Warning.Light">#2D2610</Color>
    <SolidColorBrush x:Key="Brush.Status.Warning.Light" Color="{StaticResource Color.Status.Warning.Light}" />

    <Color x:Key="Color.Status.Success.Light">#152D17</Color>
    <SolidColorBrush x:Key="Brush.Status.Success.Light" Color="{StaticResource Color.Status.Success.Light}" />
</ResourceDictionary>
