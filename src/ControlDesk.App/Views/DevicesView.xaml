<UserControl x:Class="ControlDesk.App.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Paired Devices" Style="{StaticResource Text.Heading2}" />
            <TextBlock Grid.Column="1" Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="16,0,0,0" />
            <Button Grid.Column="2" Style="{StaticResource Button.Secondary}" Command="{Binding RefreshCommand}" Padding="12,6" MinWidth="80">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="↻ " FontSize="12" />
                    <TextBlock Text="Refresh" Style="{StaticResource Text.Body}" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Devices List -->
        <Border Grid.Row="1" Style="{StaticResource Card}" MinHeight="350">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Column Headers -->
                <Border Grid.Row="0" Background="{StaticResource Brush.Background.Tertiary}" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="" />
                        <TextBlock Grid.Column="1" Text="Device Name &amp; ID" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Last Connected" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="Status" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="Unattended" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="Connect" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="6" Text="Auto Connect" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="7" Text="" />
                    </Grid>
                </Border>

                <!-- Device Items -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="0,0,0,1" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Device Avatar -->
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="{StaticResource Brush.Accent.Primary}" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding FormattedId, Converter={StaticResource FirstTwoCharsConverter}}" Style="{StaticResource Text.Caption}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                        </Border>

                                        <!-- Device Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Text.Body}" />
                                            <TextBlock Text="{Binding FormattedId}" Style="{StaticResource Text.Code}" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" FontFamily="Consolas, monospace" />
                                        </StackPanel>

                                        <!-- Last Connected -->
                                        <TextBlock Grid.Column="2" Text="{Binding LastConnectedText}" Style="{StaticResource Text.BodySecondary}" VerticalAlignment="Center" />

                                        <!-- Online Status -->
                                        <Ellipse Grid.Column="3" Width="10" Height="10" Fill="{Binding IsOnline, Converter={StaticResource BooleanToBrushConverter}}" VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip="{Binding OnlineStatus}" />

                                        <!-- Unattended Toggle -->
                                        <CheckBox Grid.Column="4" IsChecked="{Binding IsTrusted, Mode=TwoWay}" Command="{Binding DataContext.ToggleUnattendedAccessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip="Allow unattended access" />

                                        <!-- Connect Button -->
                                        <Button Grid.Column="5" Style="{StaticResource Button.Primary}" Content="Connect" Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="8,4" MinWidth="75" VerticalAlignment="Center" HorizontalAlignment="Center" />

                                        <!-- Unattended Connect Button -->
                                        <Button Grid.Column="6" Style="{StaticResource Button.Secondary}" Content="Unattended" Command="{Binding DataContext.ConnectUnattendedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="8,4" MinWidth="85" VerticalAlignment="Center" HorizontalAlignment="Center" IsEnabled="{Binding IsTrusted}" ToolTip="Connect with unattended access" />

                                        <!-- Remove Button -->
                                        <Button Grid.Column="7" Style="{StaticResource Button.Secondary}" Content="✕" Command="{Binding DataContext.RemoveDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip="Remove device" Foreground="{StaticResource Brush.Status.Error}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty State -->
                <Border Grid.Row="1" Background="Transparent" Visibility="{Binding Devices.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🔗" FontSize="44" Margin="0,0,0,12" HorizontalAlignment="Center" />
                        <TextBlock Text="No paired devices yet" Style="{StaticResource Text.Heading3}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="Connect to a remote device from the Home tab to add it here." Style="{StaticResource Text.BodySecondary}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="400" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Legend / Help -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                    <Ellipse Width="10" Height="10" Fill="Green" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Online (seen recently)" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                    <Ellipse Width="10" Height="10" Fill="Gray" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Offline" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                    <CheckBox VerticalAlignment="Center" IsEnabled="False" IsChecked="True" Margin="0,0,6,0" />
                    <TextBlock Text="Unattended access granted" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <CheckBox VerticalAlignment="Center" IsEnabled="False" IsChecked="False" Margin="0,0,6,0" />
                    <TextBlock Text="Manual confirmation required" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>