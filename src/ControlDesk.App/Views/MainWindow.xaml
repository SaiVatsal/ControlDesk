<Window x:Class="ControlDesk.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ControlDesk.App.Views"
        xmlns:vms="clr-namespace:ControlDesk.App.ViewModels"
        mc:Ignorable="d"
        Title="ControlDesk"
        Height="720"
        Width="1100"
        MinHeight="600"
        MinWidth="900"
        Background="{StaticResource Brush.Background.Primary}"
        Foreground="{StaticResource Brush.Text.Primary}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Bar -->
            <RowDefinition Height="*" />    <!-- Content -->
            <RowDefinition Height="Auto" /> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Top Navigation Bar -->
        <Border Grid.Row="0"
                Background="{StaticResource Brush.Background.Secondary}"
                BorderBrush="{StaticResource Brush.Border.Subtle}"
                BorderThickness="0,0,0,1"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Title / Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="28" Height="28"
                             Fill="{StaticResource Brush.Accent.Primary}"
                             Margin="0,0,10,0" />
                    <TextBlock Text="ControlDesk"
                               Style="{StaticResource Text.Heading3}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Navigation Tabs -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource Button.Navigation}"
                                 Content="Home"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Home}" />
                    <RadioButton Style="{StaticResource Button.Navigation}"
                                 Content="Devices"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Devices}" />
                    <RadioButton Style="{StaticResource Button.Navigation}"
                                 Content="Session"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=ActiveSession}" />
                    <RadioButton Style="{StaticResource Button.Navigation}"
                                 Content="Transfers"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=FileTransfers}" />
                    <RadioButton Style="{StaticResource Button.Navigation}"
                                 Content="History"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=SessionHistory}" />
                    <RadioButton Style="{StaticResource Button.Navigation}"
                                 Content="Settings"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Settings}" />
                </StackPanel>

                <!-- Connection Status & Actions -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <!-- Status Indicator -->
                    <Border Width="10" Height="10"
                            CornerRadius="5"
                            Background="{Binding ConnectionStatusColor}"
                            Margin="0,0,8,0"
                            ToolTip="{Binding ConnectionStatusText}" />

                    <TextBlock Text="{Binding ConnectionStatusText}"
                               Style="{StaticResource Text.BodySecondary}"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0" />

                    <!-- Minimize to Tray Button -->
                    <Button Style="{StaticResource Button.Secondary}"
                            Content="↓"
                            ToolTip="Minimize to Tray"
                            Command="{Binding MinimizeToTrayCommand}"
                            Width="32" Height="32"
                            FontSize="14"
                            Padding="0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <ContentControl Grid.Row="1"
                        Content="{Binding CurrentView}"
                        Margin="0" />

        <!-- Status Bar -->
        <Border Grid.Row="2"
                Background="{StaticResource Brush.Background.Secondary}"
                BorderBrush="{StaticResource Brush.Border.Subtle}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Style="{StaticResource Text.Caption}" />

                <TextBlock Grid.Column="2"
                           Text="{Binding VersionInfo}"
                           Style="{StaticResource Text.Caption}"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>