<UserControl x:Class="ControlDesk.App.Views.FileTransfersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="File Transfers" Style="{StaticResource Text.Heading2}" />
            <Button Grid.Column="2" Style="{StaticResource Button.Primary}" Command="{Binding SendFileCommand}" Padding="12,6" MinWidth="100">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📤" FontSize="14" Margin="0,0,6,0" />
                    <TextBlock Text="Send File" Style="{StaticResource Text.Body}" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Transfer Tabs -->
        <TabControl Grid.Row="1" Style="{StaticResource TabControl.Default}" BorderThickness="0">
            <!-- Active Transfers -->
            <TabItem Header="Active" Style="{StaticResource TabItem.Default}">
                <Border Style="{StaticResource Card}" MinHeight="350">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Column Headers -->
                        <Border Grid.Row="0" Background="{StaticResource Brush.Background.Tertiary}" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="" />
                                <TextBlock Grid.Column="1" Text="File Name" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="Size" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="Progress" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="Speed" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="5" Text="Status" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="6" Text="Actions" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Active Transfers List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding ActiveTransfers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="0,0,0,1" Padding="12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="100" />
                                                </Grid.ColumnDefinitions>

                                                <!-- File Type Icon -->
                                                <TextBlock Grid.Column="0" Text="{Binding FileTypeIcon}" Style="{StaticResource Text.Body}" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center" />

                                                <!-- File Info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="0">
                                                    <TextBlock Text="{Binding FileName}" Style="{StaticResource Text.Body}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding TransferDirectionText}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Text.Muted}" FontSize="10" />
                                                </StackPanel>

                                                <!-- File Size -->
                                                <TextBlock Grid.Column="2" Text="{Binding FileSizeText}" Style="{StaticResource Text.Body}" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas, monospace" />

                                                <!-- Progress Bar -->
                                                <Grid Grid.Column="3" VerticalAlignment="Center" Margin="8,0">
                                                    <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="6" Background="{StaticResource Brush.Background.Tertiary}" Foreground="{StaticResource Brush.Accent.Primary}" />
                                                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Primary}" FontFamily="Consolas, monospace" FontSize="10" />
                                                </Grid>

                                                <!-- Speed -->
                                                <TextBlock Grid.Column="4" Text="{Binding SpeedText}" Style="{StaticResource Text.BodySecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas, monospace" FontSize="11" />

                                                <!-- Status -->
                                                <TextBlock Grid.Column="5" Text="{Binding StatusText}" Style="{StaticResource Text.Body}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding StatusColor}" />

                                                <!-- Actions -->
                                                <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource Button.Flat.Icon}"
                                                            Command="{Binding DataContext.PauseResumeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="{Binding PauseResumeTooltip}"
                                                            Padding="4"
                                                            Margin="0,0,4,0"
                                                            Width="28" Height="28"
                                                            Visibility="{Binding CanPauseResume, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding PauseResumeIcon}" Style="{StaticResource Text.Body}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Button>
                                                    <Button Style="{StaticResource Button.Flat.Icon}"
                                                            Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Cancel"
                                                            Padding="4"
                                                            Width="28" Height="28"
                                                            Foreground="{StaticResource Brush.Status.Error}">
                                                        <TextBlock Text="✕" Style="{StaticResource Text.Body}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Empty State -->
                        <Border Grid.Row="1" Background="Transparent" Visibility="{Binding ActiveTransfers.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="📤" FontSize="44" Margin="0,0,0,12" HorizontalAlignment="Center" />
                                <TextBlock Text="No active transfers" Style="{StaticResource Text.Heading3}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <TextBlock Text="Click 'Send File' to start a new transfer" Style="{StaticResource Text.BodySecondary}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Completed Transfers -->
            <TabItem Header="History" Style="{StaticResource TabItem.Default}">
                <Border Style="{StaticResource Card}" MinHeight="350">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Column Headers -->
                        <Border Grid.Row="0" Background="{StaticResource Brush.Background.Tertiary}" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="" />
                                <TextBlock Grid.Column="1" Text="File Name" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="Size" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="Completed" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="Duration" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="5" Text="Avg Speed" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="6" Text="Status" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- History List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding CompletedTransfers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="0,0,0,1" Padding="12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>

                                                <!-- File Type Icon -->
                                                <TextBlock Grid.Column="0" Text="{Binding FileTypeIcon}" Style="{StaticResource Text.Body}" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center" />

                                                <!-- File Info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="0">
                                                    <TextBlock Text="{Binding FileName}" Style="{StaticResource Text.Body}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding TransferDirectionText}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Text.Muted}" FontSize="10" />
                                                </StackPanel>

                                                <!-- File Size -->
                                                <TextBlock Grid.Column="2" Text="{Binding FileSizeText}" Style="{StaticResource Text.Body}" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas, monospace" />

                                                <!-- Completed Time -->
                                                <TextBlock Grid.Column="3" Text="{Binding CompletedTimeText}" Style="{StaticResource Text.BodySecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas, monospace" FontSize="11" />

                                                <!-- Duration -->
                                                <TextBlock Grid.Column="4" Text="{Binding DurationText}" Style="{StaticResource Text.BodySecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas, monospace" FontSize="11" />

                                                <!-- Average Speed -->
                                                <TextBlock Grid.Column="5" Text="{Binding AvgSpeedText}" Style="{StaticResource Text.BodySecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas, monospace" FontSize="11" />

                                                <!-- Status -->
                                                <TextBlock Grid.Column="6" Text="{Binding FinalStatusText}" Style="{StaticResource Text.Body}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding FinalStatusColor}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Empty State -->
                        <Border Grid.Row="1" Background="Transparent" Visibility="{Binding CompletedTransfers.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="📁" FontSize="44" Margin="0,0,0,12" HorizontalAlignment="Center" />
                                <TextBlock Text="No transfer history" Style="{StaticResource Text.Heading3}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <TextBlock Text="Completed transfers will appear here" Style="{StaticResource Text.BodySecondary}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Summary Footer -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                    <TextBlock Text="Active: " Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ActiveTransfers.Count}" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                    <TextBlock Text="Completed: " Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CompletedTransfers.Count}" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                    <TextBlock Text="Total Sent: " Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TotalBytesSent, Converter={StaticResource FileSizeConverter}}" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Total Received: " Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TotalBytesReceived, Converter={StaticResource FileSizeConverter}}" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>