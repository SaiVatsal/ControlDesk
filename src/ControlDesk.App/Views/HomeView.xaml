<UserControl x:Class="ControlDesk.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Device Identity Card -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Your Device Identity" Style="{StaticResource Text.Heading2}" Margin="0,0,0,8" />

                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="64" Height="64" CornerRadius="8" Background="{StaticResource Brush.Accent.Primary}">
                        <TextBlock Text="CD" Style="{StaticResource Text.Heading2}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="{Binding DeviceName}" Style="{StaticResource Text.Heading3}" />
                        <TextBlock Text="{Binding DeviceId}" Style="{StaticResource Text.Code}" FontSize="16" FontFamily="Consolas, 'Cascadia Code', monospace" Foreground="{StaticResource Brush.Text.Primary}" />
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource Button.Secondary}" Command="{Binding CopyDeviceIdCommand}" ToolTip="Copy Device ID" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="Copy" Style="{StaticResource Text.Body}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Online Status -->
                <Border Grid.Row="2" Background="{StaticResource Brush.Background.Tertiary}" CornerRadius="6" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{Binding IsOnline, Converter={StaticResource BooleanToBrushConverter}}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Quick Connect Card -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Quick Connect" Style="{StaticResource Text.Heading2}" Margin="0,0,0,16" />

                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Style="{StaticResource TextBox.Default}"
                             Text="{Binding RemoteDeviceId, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Enter the 9-digit Device ID of the remote computer (e.g. 123-456-789)" />

                    <Button Grid.Column="1" Style="{StaticResource Button.Primary}"
                            Command="{Binding ConnectCommand}"
                            IsEnabled="{Binding IsConnecting, Converter={StaticResource InverseBooleanConverter}}"
                            Margin="8,0,0,0" Padding="20,0"
                            MinWidth="100">
                        <TextBlock Text="{Binding IsConnecting, Converter={StaticResource BooleanToTextConverter}, ConverterParameter='Connecting...|Connect'}" Style="{StaticResource Text.Body}" />
                    </Button>
                </Grid>

                <CheckBox Grid.Row="2" Content="Request unattended access (if trusted by remote device)"
                          IsChecked="{Binding RequestUnattendedAccess}"
                          Style="{StaticResource CheckBox.Default}"
                          Margin="0,8,0,0" />

                <!-- Error Display -->
                <Border Grid.Row="2" Background="{StaticResource Brush.Status.Error.Light}"
                        BorderBrush="{StaticResource Brush.Status.Error}" BorderThickness="1"
                        CornerRadius="4" Padding="10" Margin="0,12,0,0"
                        Visibility="{Binding HasConnectionError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding ConnectionError}" Style="{StaticResource Text.BodySecondary}" Foreground="{StaticResource Brush.Status.Error}" TextWrapping="Wrap" />
                        <Button Grid.Column="1" Style="{StaticResource Button.Flat}" Content="✕" Command="{Binding ClearErrorCommand}" Padding="8,2" Margin="8,0,0,0" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Recent Devices / Info -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Recent Devices" Style="{StaticResource Text.Heading2}" Margin="0,0,0,8" />
                <TextBlock Grid.Row="1" Text="No recent connections yet. Connect to a device to see it here." Style="{StaticResource Text.BodySecondary}" />
            </Grid>
        </Border>

        <!-- Instructions / Help -->
        <Border Grid.Row="3" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Getting Started" Style="{StaticResource Text.Heading2}" Margin="0,0,0,16" />

                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,12">
                        <Run Text="1. " FontWeight="Bold" />Share your Device ID (above) with the person you want to connect with.
                    </TextBlock>
                    <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,12">
                        <Run Text="2. " FontWeight="Bold" />Enter their Device ID in the Quick Connect box above and click Connect.
                    </TextBlock>
                    <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,12">
                        <Run Text="3. " FontWeight="Bold" />The remote user will see a prompt to approve the connection.
                    </TextBlock>
                    <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,12">
                        <Run Text="4. " FontWeight="Bold" />Once approved, the session will appear in the Active Session tab.
                    </TextBlock>
                    <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,12">
                        <Run Text="5. " FontWeight="Bold" />For unattended access, the remote user must add you as a trusted device in their Devices tab.
                    </TextBlock>
                </StackPanel>

                <Border Background="{StaticResource Brush.Background.Tertiary}" CornerRadius="6" Padding="12" Margin="0,16,0,0">
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap">
                        <Run Text="Tip: " FontWeight="Bold" />ControlDesk works across international boundaries (India ↔ Dubai) using WebRTC with TURN relay fallback.
                        Sessions have no time limits and will automatically reconnect if the network drops.
                    </TextBlock>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>