<Window x:Class="ControlDesk.App.Views.IncomingConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Incoming Connection"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="500"
        MaxWidth="550"
        Background="{StaticResource Brush.Background.Primary}"
        BorderBrush="{StaticResource Brush.Border.Subtle}"
        BorderThickness="1"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="SingleBorderWindow"
        d:DesignHeight="500" d:DesignWidth="500">

    <Border Style="{StaticResource Card}" Padding="24">
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="64" Height="64" CornerRadius="8" Background="{StaticResource Brush.Accent.Primary}">
                    <TextBlock Text="⬇" Style="{StaticResource Text.Heading1}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="20" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="Incoming Connection Request" Style="{StaticResource Text.Heading2}" />
                    <TextBlock Text="{Binding RemoteDeviceName}" Style="{StaticResource Text.Heading3}" Foreground="{StaticResource Brush.Accent.Primary}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding FormattedRemoteDeviceId}" Style="{StaticResource Text.Code}" FontSize="13" FontFamily="Consolas, monospace" Foreground="{StaticResource Brush.Text.Secondary}" />
                </StackPanel>
            </Grid>

            <!-- Device Fingerprint -->
            <Border Background="{StaticResource Brush.Background.Tertiary}" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Device Fingerprint" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Text.Muted}" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding RemoteKeyFingerprint}" Style="{StaticResource Text.Code}" FontSize="11" FontFamily="Consolas, monospace" TextWrapping="Wrap" />
                    <TextBlock Text="Verify this fingerprint matches what the remote user sees on their screen." Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Text.Muted}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Permissions -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Grant Permissions" Style="{StaticResource Text.Heading3}" Margin="0,0,8,0" />
                <TextBlock Text="Select what this remote device is allowed to do:" Style="{StaticResource Text.BodySecondary}" Margin="0,0,0,12" />

                <CheckBox Content="🖥  Screen Viewing — View your desktop screen"
                          IsChecked="{Binding AllowScreenView, Mode=TwoWay}"
                          Style="{StaticResource CheckBox.Default}"
                          Margin="0,0,0,8" />

                <CheckBox Content="🖱  Mouse &amp; Keyboard Control — Full remote control of this computer"
                          IsChecked="{Binding AllowInputControl, Mode=TwoWay}"
                          Style="{StaticResource CheckBox.Default}"
                          Margin="0,0,0,8" />

                <CheckBox Content="📋 Clipboard Synchronization — Share clipboard content"
                          IsChecked="{Binding AllowClipboardSync, Mode=TwoWay}"
                          Style="{StaticResource CheckBox.Default}"
                          Margin="0,0,0,8" />

                <CheckBox Content="📁 File Transfers — Send and receive files"
                          IsChecked="{Binding AllowFileTransfer, Mode=TwoWay}"
                          Style="{StaticResource CheckBox.Default}"
                          Margin="0,0,0,8" />

                <CheckBox Content="💬 Text Chat — Exchange messages during session"
                          IsChecked="{Binding AllowChat, Mode=TwoWay}"
                          Style="{StaticResource CheckBox.Default}" />
            </StackPanel>

            <!-- Remember Device Option -->
            <CheckBox Content="Remember this device and allow unattended access in the future (adds to Trusted Devices)"
                      IsChecked="{Binding RememberAsTrusted, Mode=TwoWay}"
                      Style="{StaticResource CheckBox.Default}"
                      Margin="0,0,0,20"
                      Foreground="{StaticResource Brush.Accent.Primary}" />

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Button.Secondary}"
                        Command="{Binding DeclineCommand}"
                        Padding="20,8" MinWidth="100"
                        Margin="0,0,12,0">
                    <TextBlock Text="Decline" Style="{StaticResource Text.Body}" />
                </Button>
                <Button Style="{StaticResource Button.Primary}"
                        Command="{Binding AcceptCommand}"
                        Padding="20,8" MinWidth="120"
                        IsDefault="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✓" FontSize="13" Margin="0,0,6,0" />
                        <TextBlock Text="Accept &amp; Connect" Style="{StaticResource Text.Body}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>